# QIE Studio configuration (copy to .env; all keys are prefixed QIE_).
# Nothing host-specific is hard-coded — these drive local + cloud deployments alike.

# --- Server ---
QIE_HOST=0.0.0.0
QIE_PORT=8000
QIE_LOG_LEVEL=INFO
# Comma-separated or JSON list. Use the SPA origin in production.
QIE_CORS_ORIGINS=*

# --- Database (PostgreSQL) ---
# In Docker Compose the host is the `db` service name.
QIE_DATABASE_URL=postgresql+psycopg://qie:qie@db:5432/qie
QIE_RUN_MIGRATIONS_ON_STARTUP=true

# --- Storage + model cache (mounted as volumes) ---
QIE_STORAGE_BACKEND=local
QIE_DATA_ROOT=/data
QIE_MODELS_CACHE=/models

# --- Device / precision (DESIGN §9) ---
# Leave QIE_DEVICE_OVERRIDE empty to auto-detect (cuda/rocm/mps/cpu).
QIE_DEVICE_OVERRIDE=
QIE_DEFAULT_PRECISION=bf16
QIE_WARMUP_ON_STARTUP=false

# --- Default model ids (overridable at run time) ---
QIE_DEFAULT_EDIT_MODEL=Qwen/Qwen-Image-Edit-2511
QIE_DEFAULT_GENERATE_MODEL=Qwen/Qwen-Image
QIE_DEFAULT_REWRITER_MODEL=Qwen/Qwen3-VL-8B-Instruct

# --- Live latent previews (steps between throttled decodes; 0 disables) ---
QIE_PREVIEW_EVERY_N_STEPS=5

# --- Secret used to derive the Fernet key that encrypts integration API keys ---
# MUST be set to a strong random value in any real deployment.
QIE_SECRET_KEY=change-me-to-a-long-random-secret

# --- SPA static assets directory (built frontend) ---
QIE_FRONTEND_DIST=/app/frontend_dist
